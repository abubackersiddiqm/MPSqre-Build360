# Build360 v1.0.0 environment template.
# Prefer the dedicated files below and never commit the real .env.* files:
#   backend/.env.development
#   backend/.env.testing
#   backend/.env.demo
#   backend/.env.production
# Copy backend/.env.development.example to backend/.env.development for local work.
BUILD360_ENVIRONMENT=demo
APP_ENV=demo
APP_VERSION=1.0.0
LOCAL_NO_DOCKER=true
BUILD360_DATABASE_NAME_GUARD=build360_demo

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-for-demo-only
JWT_SIGNING_KEY=replace-with-a-different-at-least-50-character-signing-key
JWT_ISSUER=mpsqre-build360
JWT_AUDIENCE=mpsqre-build360-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_STEP_UP_TTL_SECONDS=300
PASSWORD_RESET_TIMEOUT=3600
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://build360:replace-me@localhost:5432/build360_demo
DATABASE_SSLMODE=prefer

REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_BUCKET=build360-demo
OBJECT_STORAGE_REGION=auto
FILE_UPLOAD_MAX_BYTES=26214400
FILE_UPLOAD_URL_TTL_SECONDS=900
FILE_DOWNLOAD_URL_TTL_SECONDS=300

CRM_PROTECTED_DATA_KEYS=replace-with-url-safe-base64-fernet-key
CRM_BLIND_INDEX_KEY=replace-with-independent-random-secret
CRM_CONTACT_REVEAL_THROTTLE_RATE=30/minute

COMMUNICATION_CALLBACK_KEYS_JSON={}
COMMUNICATION_LOCAL_ADAPTER_ENABLED=true
BUILD360_PUBLIC_WEB_URL=http://localhost:3000
BUILD360_TRANSACTIONAL_FROM_EMAIL=notifications@mpsqre.com
BUILD360_SUPPORT_EMAIL=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

AI_LOCAL_ADAPTER_ENABLED=true
AI_MAX_PROMPT_CHARACTERS=8000
AI_EXTRACTION_MAX_CHARACTERS=50000
INTEGRATION_LOCAL_SIMULATION_ENABLED=true
INTEGRATION_WEBHOOK_MAX_ATTEMPTS=5

ADMINOPS_DEFAULT_REGION=local
ADMINOPS_HEALTH_RETENTION_DAYS=90
ADMINOPS_RELEASE_CHECKS_REQUIRED=true
CONTROLPLANE_SUPPORT_MAX_HOURS=24
CONTROLPLANE_USAGE_RETENTION_DAYS=400
COMPLIANCE_EXCEPTION_MAX_DAYS=90
COMPLIANCE_ASSESSMENT_RETENTION_DAYS=2555
CLOUDOPS_DEPLOYMENT_EVIDENCE_REQUIRED=true
CLOUDOPS_BACKUP_RETENTION_MIN_DAYS=30
CLOUDOPS_SECRET_ROTATION_WARNING_DAYS=14
SUCCESSOPS_RENEWAL_WARNING_DAYS=90
SUCCESSOPS_SUPPORT_RETENTION_DAYS=1095
PEOPLEOPS_PAYROLL_RETENTION_DAYS=2555
PEOPLEOPS_LEAVE_YEAR_START_MONTH=1
BUILD360_PLATFORM_DOMAIN_SUFFIX=build360.local
BUILD360_CUSTOM_DOMAIN_CNAME_TARGET=domains.build360.local

# Demo-only login password used by Seed-Demo-Data.bat. Change before sharing the demo.
BUILD360_DEMO_ADMIN_PASSWORD=Build360Demo@2026
