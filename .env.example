# Never use these example values outside local development.
APP_ENV=local
APP_VERSION=0.19.1
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
JWT_SIGNING_KEY=replace-with-a-distinct-at-least-50-character-signing-key
JWT_ISSUER=mpsqre-build360
JWT_AUDIENCE=mpsqre-build360-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_STEP_UP_TTL_SECONDS=300
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://build360:replace-me@postgres:5432/build360
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_BUCKET=build360-private
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
FILE_UPLOAD_MAX_BYTES=26214400
FILE_UPLOAD_URL_TTL_SECONDS=900
FILE_DOWNLOAD_URL_TTL_SECONDS=300
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
INTERNAL_API_BASE_URL=http://api:8000/api/v1

# Phase 4 CRM protected-data controls
# Use one or more comma-separated Fernet keys. New encryption uses the first key.
CRM_PROTECTED_DATA_KEYS=replace-with-url-safe-base64-fernet-key
CRM_BLIND_INDEX_KEY=replace-with-independent-random-secret

# Phase 9 communications. Use secret-manager references in production.
COMMUNICATION_CALLBACK_KEYS_JSON={}
COMMUNICATION_LOCAL_ADAPTER_ENABLED=false

# Transactional account invitations / password-recovery delivery.
# Keep the envelope sender on a Build360-controlled verified domain. White-label
# tenants change the display name/body; custom sender domains require separate DNS verification.
BUILD360_PUBLIC_WEB_URL=http://localhost:3000
BUILD360_TRANSACTIONAL_FROM_EMAIL=notifications@mpsqre.com
BUILD360_SUPPORT_EMAIL=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false


# Phase 11 governed AI. External providers remain disabled by default.
AI_LOCAL_ADAPTER_ENABLED=false
AI_MAX_PROMPT_CHARACTERS=8000
AI_EXTRACTION_MAX_CHARACTERS=50000

# Phase 12 enterprise administration and reliability
ADMINOPS_DEFAULT_REGION=local
ADMINOPS_HEALTH_RETENTION_DAYS=90
ADMINOPS_RELEASE_CHECKS_REQUIRED=true
CONTROLPLANE_SUPPORT_MAX_HOURS=24
CONTROLPLANE_USAGE_RETENTION_DAYS=400

COMPLIANCE_EXCEPTION_MAX_DAYS=90
COMPLIANCE_ASSESSMENT_RETENTION_DAYS=2555

# Phase 18 cloud launch and deployment governance
CLOUDOPS_DEPLOYMENT_EVIDENCE_REQUIRED=true
CLOUDOPS_BACKUP_RETENTION_MIN_DAYS=30
CLOUDOPS_SECRET_ROTATION_WARNING_DAYS=14

# Phase 19 customer success and commercialization
SUCCESSOPS_RENEWAL_WARNING_DAYS=90
SUCCESSOPS_SUPPORT_RETENTION_DAYS=1095

# Phase 20 people operations
PEOPLEOPS_PAYROLL_RETENTION_DAYS=2555
PEOPLEOPS_LEAVE_YEAR_START_MONTH=1
# White-label tenant domains. Production values must point to the deployed Build360 edge.
BUILD360_PLATFORM_DOMAIN_SUFFIX=build360.local
BUILD360_CUSTOM_DOMAIN_CNAME_TARGET=domains.build360.local
