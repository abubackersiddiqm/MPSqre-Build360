# ============================================================
# MPSqre Build360 - Git Ignore
# Production-safe repository exclusions
# ============================================================


# ============================================================
# Environment variables / secrets
# ============================================================
.env
.env.*
.env.local
.env.*.local

# Safe environment templates only
!.env.example
!.env.*.example
!backend/.env.example
!backend/.env.*.example
!frontend/.env.example
!frontend/.env.*.example


# ============================================================
# Python virtual environments / generated dependencies
# ============================================================
.venv/
venv/
env/
ENV/

backend/.venv/
backend/venv/

.backend-deps/
backend/.backend-deps/


# ============================================================
# Python cache / compiled artifacts
# ============================================================
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/

.coverage
.coverage.*
htmlcov/

.pyre/
.pyright/


# ============================================================
