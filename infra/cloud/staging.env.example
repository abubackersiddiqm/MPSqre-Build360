APP_ENV=staging
APP_VERSION=0.18.0
LOCAL_NO_DOCKER=false
DJANGO_ALLOWED_HOSTS=staging.build360.example.com,staging-api.build360.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://staging.build360.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.build360.example.com
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-POSTGRES:5432/build360_staging
DATABASE_SSLMODE=require
REDIS_URL=rediss://STAGING-REDIS:6379/0
CELERY_BROKER_URL=rediss://STAGING-REDIS:6379/1
CELERY_RESULT_BACKEND=rediss://STAGING-REDIS:6379/2
OBJECT_STORAGE_ENDPOINT=https://staging-objects.example.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://staging-objects.example.com
OBJECT_STORAGE_BUCKET=build360-staging-private
OBJECT_STORAGE_REGION=replace-with-region
ADMINOPS_RELEASE_CHECKS_REQUIRED=true
CLOUDOPS_DEPLOYMENT_EVIDENCE_REQUIRED=true
