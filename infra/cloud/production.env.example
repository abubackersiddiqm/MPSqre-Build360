# Production values must be injected from an approved secret manager.
APP_ENV=production
APP_VERSION=0.18.0
LOCAL_NO_DOCKER=false
DJANGO_ALLOWED_HOSTS=build360.example.com,api.build360.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://build360.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://build360.example.com
DATABASE_URL=postgresql://USER:PASSWORD@MANAGED-POSTGRES:5432/build360
DATABASE_SSLMODE=verify-full
REDIS_URL=rediss://MANAGED-REDIS:6379/0
CELERY_BROKER_URL=rediss://MANAGED-REDIS:6379/1
CELERY_RESULT_BACKEND=rediss://MANAGED-REDIS:6379/2
OBJECT_STORAGE_ENDPOINT=https://s3-compatible.example.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_BUCKET=build360-production-private
OBJECT_STORAGE_REGION=replace-with-region
COMMUNICATION_LOCAL_ADAPTER_ENABLED=false
AI_LOCAL_ADAPTER_ENABLED=false
ADMINOPS_RELEASE_CHECKS_REQUIRED=true
CLOUDOPS_DEPLOYMENT_EVIDENCE_REQUIRED=true
CLOUDOPS_BACKUP_RETENTION_MIN_DAYS=30
CLOUDOPS_SECRET_ROTATION_WARNING_DAYS=14
